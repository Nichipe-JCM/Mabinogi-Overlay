<Window x:Class="TestOverlay.App.CloseBehaviorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TestOverlay.App.Controls"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Close behavior"
        loc:Localize.TitleKey="settings.close.behavior"
        Icon="/Image/AppIcon.ico"
        Width="500"
        Height="285"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OverlayBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="8" GlassFrameThickness="0"
                            ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="8,4,8,8" Style="{StaticResource AppWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:AppTitleBar/>
        <Border Grid.Row="1" Padding="20" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Close behavior" loc:Localize.TextKey="settings.close.behavior"
                           Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Grid.Row="1" Margin="0,9,0,0"
                           Text="What should happen when you close the app window?"
                           loc:Localize.TextKey="close.dialog.description"
                           Style="{StaticResource MutedTextStyle}"/>
                <CheckBox x:Name="RememberChoiceCheckBox" Grid.Row="2" Margin="0,20,0,0"
                          VerticalAlignment="Top" Content="Don't ask again"
                          loc:Localize.ContentKey="close.dialog.dont.ask.again"/>
                <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                    <Button MinWidth="112" Height="38" Padding="14,0" Content="Exit app"
                            loc:Localize.ContentKey="settings.close.behavior.exit" Click="ExitButton_Click"/>
                    <Button MinWidth="150" Height="38" Padding="14,0" Margin="8,0,0,0"
                            Content="Minimize to tray" loc:Localize.ContentKey="settings.close.behavior.tray"
                            Click="MinimizeToTrayButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
