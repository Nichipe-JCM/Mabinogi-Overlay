<Window x:Class="TestOverlay.App.OverlayPlacementPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        Title="Overlay Placement Preview"
        Icon="/Image/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MinWidth="120"
        MinHeight="114">
    <Window.Resources>
        <Style x:Key="PreviewResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Panel.ZIndex" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#CC00A6FF" BorderBrush="White" BorderThickness="1" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="DragHeader"
                Height="28"
                Margin="0,0,34,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="#F024272A"
                BorderBrush="#E689DED4"
                BorderThickness="1"
                CornerRadius="4"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
            <Grid Margin="9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="⋮⋮"
                           Foreground="#89DED4"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           Text="Overlay preview"
                           loc:Localize.TextKey="layout.preview.drag.header"
                           Foreground="White"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border x:Name="PreviewBorder"
                Margin="0,34,0,0"
                BorderBrush="#00A6FF"
                BorderThickness="2"
                Background="#2200A6FF"
                MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown">
            <Canvas x:Name="PreviewCanvas"
                    IsHitTestVisible="False"/>
        </Border>
        <Thumb Tag="NW"
               Margin="0,34,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Cursor="SizeNWSE"
               Style="{StaticResource PreviewResizeThumbStyle}"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Tag="NE"
               Margin="0,34,0,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Cursor="SizeNESW"
               Style="{StaticResource PreviewResizeThumbStyle}"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Tag="SW"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Cursor="SizeNESW"
               Style="{StaticResource PreviewResizeThumbStyle}"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Tag="SE"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Style="{StaticResource PreviewResizeThumbStyle}"
               DragDelta="ResizeThumb_DragDelta"/>
        <Button Width="28"
                Height="28"
                Margin="0,2,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="X"
                Panel.ZIndex="10"
                Background="#F024272A"
                Foreground="#89DED4"
                BorderBrush="#E689DED4"
                BorderThickness="1"
                FontSize="14"
                FontWeight="Bold"
                Padding="0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
