<UserControl x:Class="TestOverlay.App.ErinTimerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TestOverlay.App.Services"
             Background="{StaticResource OverlayBgBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <TextBlock Text="Current Erin time" loc:Localize.TextKey="erin.current.time" Style="{StaticResource SectionTitleStyle}"/>
                    </Border>
                    <Grid Grid.Row="1" Margin="14,8,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GameTimeText" Text="00:00" VerticalAlignment="Center"
                                   FontFamily="Bahnschrift Light, Segoe UI Variable" FontSize="42"
                                   Foreground="{StaticResource OverlayTextBrush}"/>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RealTimeText" Foreground="{StaticResource OverlayMutedBrush}"/>
                            <TextBlock x:Name="NextAlarmText" Margin="0,5,0,0" TextWrapping="Wrap"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OverlayAccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time synchronization" loc:Localize.TextKey="erin.time.synchronization" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="Use this when the in-game time does not match."
                                       loc:Localize.TextKey="erin.time.synchronization.hint"
                                       TextTrimming="CharacterEllipsis" Style="{StaticResource MutedTextStyle}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" MinWidth="72" Height="34" Padding="10,0"
                                Content="-0.5 sec" loc:Localize.ContentKey="erin.minus.half.second" Click="SyncMinusButton_Click"/>
                        <TextBlock x:Name="SyncDelayText" Grid.Column="1" Margin="10,0" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                        <Button Grid.Column="2" MinWidth="72" Height="34" Padding="10,0"
                                Content="+0.5 sec" loc:Localize.ContentKey="erin.plus.half.second" Click="SyncPlusButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Alarms" loc:Localize.TextKey="erin.alarms" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="AlarmCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="10,10,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="NewAlarmNameBox" Height="34" Padding="8,4" MaxLength="40"
                                 TextChanged="NewAlarmNameBox_TextChanged"
                                 GotKeyboardFocus="NewAlarmNameBox_GotKeyboardFocus"
                                 LostKeyboardFocus="NewAlarmNameBox_LostKeyboardFocus"/>
                        <TextBlock x:Name="AlarmNamePlaceholder" Margin="10,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{StaticResource OverlayMutedBrush}"
                                   Text="Set alarm name" loc:Localize.TextKey="erin.alarm.name.placeholder"/>
                    </Grid>
                    <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="74"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="HourCombo" Grid.Column="0" Height="36" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text=":" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ComboBox x:Name="MinuteCombo" Grid.Column="2" Height="36" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="NewAlarmRepeatCheckBox" Grid.Column="2" Margin="10,0"
                              Content="Repeat" loc:Localize.ContentKey="erin.repeat" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" MinWidth="58" Height="34" Padding="10,0"
                            Content="Add alarm" loc:Localize.ContentKey="erin.alarm.add" Click="AddAlarmButton_Click"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button MinWidth="58" Height="34" Padding="10,0" Margin="6,0,0,0"
                                Content="Update" loc:Localize.ContentKey="erin.update" Click="UpdateAlarmButton_Click"/>
                        <Button MinWidth="58" Height="34" Padding="10,0" Margin="6,0,0,0"
                                Content="Delete" loc:Localize.ContentKey="Delete" Click="DeleteAlarmButton_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Margin="10,0" Style="{StaticResource InsetPanelStyle}">
                    <ListBox x:Name="AlarmListBox" ItemsSource="{Binding Alarms}" Background="Transparent" BorderThickness="0"
                             PreviewMouseLeftButtonDown="AlarmListBox_PreviewMouseLeftButtonDown"
                             SelectionChanged="AlarmListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CandidateListBoxItemStyle}">
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="6,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="0,0,6,0" Text="&#x23F0;"
                                               FontFamily="Segoe UI Symbol" FontSize="14" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#55595D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource OverlayTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox x:Name="AlarmEnabledCheckBox" Grid.Column="1" Margin="0,0,8,0"
                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SoundLabel}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource OverlayMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="4" Margin="6,0,12,0" Content="Repeat" loc:Localize.ContentKey="erin.repeat"
                                              IsChecked="{Binding Repeat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                        <Button MinWidth="72" Height="28" Padding="8,0" Content="Sound..."
                                                loc:Localize.ContentKey="erin.sound.choose" Tag="{Binding Id}" Click="ChooseAlarmSoundButton_Click"/>
                                        <Button MinWidth="62" Height="28" Padding="8,0" Margin="4,0,0,0" Content="Global"
                                                loc:Localize.ContentKey="erin.sound.global" Tag="{Binding Id}" Click="UseGlobalSoundButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Grid.Row="3" Margin="12,8,12,10">
                    <TextBlock x:Name="AlarmStatusText" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="SaveWarningText" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Alarm sound" loc:Localize.TextKey="erin.alarm.sound" Style="{StaticResource PanelTitleStyle}"/>
                    <CheckBox x:Name="DesktopNotificationsCheckBox" Margin="0,4,0,0" Content="Desktop notification"
                              loc:Localize.ContentKey="erin.desktop.notification" Click="DesktopNotificationsCheckBox_Click"/>
                </StackPanel>
                <TextBlock x:Name="AudioFileText" Grid.Column="1" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{StaticResource OverlayMutedBrush}"/>
                <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VolumeText" Style="{StaticResource MutedTextStyle}"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
                <Button Grid.Column="3" MinWidth="74" Height="34" Padding="10,0" Content="Choose file"
                        loc:Localize.ContentKey="erin.choose.file" Click="ChooseGlobalSoundButton_Click"/>
                <Button x:Name="MuteButton" Grid.Column="4" MinWidth="66" Height="34" Padding="10,0" Margin="6,0,0,0" Click="MuteButton_Click"/>
                <Button Grid.Column="5" MinWidth="72" Height="34" Padding="10,0" Margin="6,0,0,0" Content="Stop sound"
                        loc:Localize.ContentKey="erin.stop.sound" Click="StopSoundButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
