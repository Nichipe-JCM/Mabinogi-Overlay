<Window x:Class="TestOverlay.App.ErinTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        xmlns:controls="clr-namespace:TestOverlay.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Erin Timer"
        loc:Localize.TitleKey="erin.timer"
        Icon="/Image/AppIcon.ico"
        Width="1040"
        Height="760"
        MinWidth="940"
        MinHeight="650"
        Background="{StaticResource OverlayBgBrush}"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="8,4,8,8" Style="{StaticResource AppWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:AppTitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="4,0,4,14">
            <TextBlock Text="Erin Timer"
                       loc:Localize.TextKey="erin.timer"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource OverlayAccentBrush}"/>
            <TextBlock Text="Track Erin time and receive configurable game-time alarms."
                       loc:Localize.TextKey="erin.timer.description"
                       Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Current Erin time" loc:Localize.TextKey="erin.current.time" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock DockPanel.Dock="Right" Text="10-minute display" loc:Localize.TextKey="erin.ten.minute.display" Style="{StaticResource MutedTextStyle}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="GameTimeText"
                                   Grid.Row="1"
                                   Text="00:00"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Bahnschrift Light, Segoe UI Variable"
                                   FontSize="88"
                                   Foreground="{StaticResource OverlayTextBrush}"/>
                        <TextBlock x:Name="RealTimeText"
                                   Grid.Row="2"
                                   Margin="12,0,12,8"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OverlayMutedBrush}"/>
                        <TextBlock x:Name="NextAlarmText"
                                   Grid.Row="3"
                                   Margin="18,0,18,22"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OverlayAccentBrush}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" MinWidth="72" Height="36" Padding="12,0" Content="-1 sec" loc:Localize.ContentKey="erin.minus.one.second" Click="SyncMinusButton_Click"/>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Time synchronization" loc:Localize.TextKey="erin.time.synchronization" HorizontalAlignment="Center" Style="{StaticResource PanelTitleStyle}"/>
                            <TextBlock x:Name="SyncDelayText" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" MinWidth="72" Height="36" Padding="12,0" Content="+1 sec" loc:Localize.ContentKey="erin.plus.one.second" Click="SyncPlusButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Alarms" loc:Localize.TextKey="erin.alarms" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="AlarmCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="14,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="HourCombo" Grid.Column="0" Width="72" Height="38"/>
                        <TextBlock Grid.Column="1" Margin="6,0" Text=":" FontSize="20" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MinuteCombo" Grid.Column="2" Width="72" Height="38"/>
                        <CheckBox x:Name="NewAlarmRepeatCheckBox" Grid.Column="3" Margin="12,0" Content="Repeat" loc:Localize.ContentKey="erin.repeat" VerticalAlignment="Center"/>
                        <Button Grid.Column="4" MinWidth="68" Height="38" Padding="12,0" Content="Add" loc:Localize.ContentKey="Add" Click="AddAlarmButton_Click"/>
                        <Button Grid.Column="5" MinWidth="76" Height="38" Padding="12,0" Margin="8,0,0,0" Content="Delete" loc:Localize.ContentKey="Delete" Click="DeleteAlarmButton_Click"/>
                    </Grid>

                    <Border Grid.Row="2" Margin="14,0" Style="{StaticResource InsetPanelStyle}">
                        <ListBox x:Name="AlarmListBox"
                                 ItemsSource="{Binding Alarms}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CandidateListBoxItemStyle}">
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Margin="0,0,8,0" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="AlarmEnabledCheckBox_Click" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="2" Margin="8,0" Content="Repeat" loc:Localize.ContentKey="erin.repeat" IsChecked="{Binding Repeat, Mode=TwoWay}" Click="AlarmRepeatCheckBox_Click" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding SoundLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource OverlayMutedBrush}"/>
                                        <Button Grid.Column="4" MinWidth="76" Height="30" Padding="10,0" Content="Sound..." loc:Localize.ContentKey="erin.sound.choose" Tag="{Binding Id}" Click="ChooseAlarmSoundButton_Click"/>
                                        <Button Grid.Column="5" MinWidth="72" Height="30" Padding="10,0" Margin="6,0,0,0" Content="Global" loc:Localize.ContentKey="erin.sound.global" Tag="{Binding Id}" Click="UseGlobalSoundButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock x:Name="AlarmStatusText" Grid.Row="3" Margin="16,10,16,14" Style="{StaticResource MutedTextStyle}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource GlassCardStyle}">
            <Grid Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Alarm sound" loc:Localize.TextKey="erin.alarm.sound" Style="{StaticResource PanelTitleStyle}"/>
                    <CheckBox x:Name="DesktopNotificationsCheckBox" Margin="0,6,0,0" Content="Desktop notification" loc:Localize.ContentKey="erin.desktop.notification" Click="DesktopNotificationsCheckBox_Click"/>
                </StackPanel>
                <TextBlock x:Name="AudioFileText" Grid.Column="1" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource OverlayMutedBrush}"/>
                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VolumeText" Style="{StaticResource MutedTextStyle}"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
                <Button Grid.Column="3" MinWidth="96" Height="36" Padding="12,0" Content="Choose file" loc:Localize.ContentKey="erin.choose.file" Click="ChooseGlobalSoundButton_Click"/>
                <Button x:Name="MuteButton" Grid.Column="4" MinWidth="78" Height="36" Padding="12,0" Margin="8,0,0,0" Click="MuteButton_Click"/>
                <Button Grid.Column="5" MinWidth="92" Height="36" Padding="12,0" Margin="8,0,0,0" Content="Stop sound" loc:Localize.ContentKey="erin.stop.sound" Click="StopSoundButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
