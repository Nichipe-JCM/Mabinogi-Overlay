<Window x:Class="TestOverlay.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        xmlns:controls="clr-namespace:TestOverlay.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        loc:Localize.TitleKey="Settings"
        Icon="/Image/AppIcon.ico"
        Width="1260"
        Height="810"
        MinWidth="960"
        MinHeight="720"
        Background="{StaticResource OverlayBgBrush}"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="8,4,8,8" Style="{StaticResource AppWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:AppTitleBar Grid.Row="0"/>


        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Settings" loc:Localize.TextKey="Settings" FontSize="22" FontWeight="Bold" Foreground="{StaticResource OverlayAccentBrush}"/>
            <TextBlock Text="Profiles, storage path, language, capture method, renderer mode, and logs." loc:Localize.TextKey="settings.description" Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <TextBlock Text="Profile" loc:Localize.TextKey="Profile" Style="{StaticResource SectionTitleStyle}"/>
                    </Border>

                    <Border Grid.Row="1" Margin="14" MinHeight="118" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Profile save folder" loc:Localize.TextKey="Profile save folder" Style="{StaticResource PanelTitleStyle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProfileDirectoryBox" Grid.Column="0" Height="40"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button Grid.Column="1" MinWidth="86" Height="40" Padding="12,0" Margin="8,0,0,0" Content="Browse" loc:Localize.ContentKey="Browse" Click="BrowseButton_Click"/>
                                <Button Grid.Column="2" MinWidth="86" Height="40" Padding="12,0" Margin="8,0,0,0" Content="Default" loc:Localize.ContentKey="Default" Click="DefaultButton_Click"/>
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Settings, profiles, and logs are stored under the current user's LocalAppData folder. A custom profile folder can still be selected."
                                       loc:Localize.TextKey="profile.storage.localappdata.description"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="14,0,14,14" MinHeight="104" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Language" loc:Localize.TextKey="Language" Style="{StaticResource PanelTitleStyle}"/>
                            <ComboBox x:Name="LanguageCombo" Height="40" Margin="0,8,0,0" DisplayMemberPath="Label"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <TextBlock Text="Runtime" loc:Localize.TextKey="Runtime" Style="{StaticResource SectionTitleStyle}"/>
                    </Border>

                    <Border Grid.Row="1" Margin="14" MinHeight="240" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Overlay renderer" loc:Localize.TextKey="Overlay renderer" Style="{StaticResource PanelTitleStyle}"/>
                            <CheckBox x:Name="AutomaticRendererCheckBox"
                                      Margin="0,10,0,0"
                                      Content="Automatic renderer selection (recommended)"
                                      loc:Localize.ContentKey="renderer.automatic.recommended"/>
                            <TextBlock x:Name="RendererSelectionSummaryText"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Name="RenderModeCombo"
                                      Height="40"
                                      Margin="0,10,0,0"
                                      DisplayMemberPath="Label"/>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Manual renderer selection is intended for troubleshooting. GPU acceleration is available only with WGC capture."
                                       loc:Localize.TextKey="renderer.manual.description"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="14,0,14,14" MinHeight="126" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Capture method" loc:Localize.TextKey="Capture method" Style="{StaticResource PanelTitleStyle}"/>
                            <ComboBox x:Name="CaptureBackendCombo" Height="40" Margin="0,8,0,0" DisplayMemberPath="Label"/>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Choose the capture source used by the running overlay. Automatic rendering uses GPU acceleration with WGC and CPU compositing with DXGI monitor or GDI. On supported Windows versions, WGC requests borderless capture permission and hides the yellow border when allowed."
                                       loc:Localize.TextKey="capture.method.description"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Margin="14,0,14,14" MinHeight="106" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Log" loc:Localize.TextKey="Log" Style="{StaticResource PanelTitleStyle}"/>
                            <TextBlock Margin="0,6,0,10"
                                       Text="Open the current session log for troubleshooting."
                                       loc:Localize.TextKey="settings.log.description"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}"/>
                            <Button MinWidth="70" Height="34" Padding="12,0" HorizontalAlignment="Left" Content="Log" loc:Localize.ContentKey="Log" Click="LogButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button MinWidth="132" Height="34" Padding="14,0" HorizontalAlignment="Left"
                    Content="Reset settings" loc:Localize.ContentKey="Reset settings" Click="ResetSettingsButton_Click"/>
            <WrapPanel HorizontalAlignment="Right">
            <Button x:Name="OkButton" MinWidth="88" Height="34" Padding="14,0" Content="OK" loc:Localize.ContentKey="OK" Click="OkButton_Click"/>
            <Button MinWidth="88" Height="34" Padding="14,0" Margin="8,0,0,0" Content="Cancel" loc:Localize.ContentKey="Cancel" IsCancel="True"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>

