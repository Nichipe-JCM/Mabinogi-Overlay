<Window x:Class="TestOverlay.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        Title="Update" loc:Localize.TitleKey="update.title" Icon="/Image/AppIcon.ico"
        Width="600" Height="530" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource OverlayBgBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="VersionsText" FontSize="20" Foreground="{StaticResource OverlayAccentBrush}"/>
        <Border Grid.Row="1" Margin="0,14,0,14" Padding="12" BorderBrush="#E9B84B" BorderThickness="1" CornerRadius="6">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource OverlayTextBrush}" loc:Localize.TextKey="update.shutdown.notice"/>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource OverlayTextBrush}"/></ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,12,0,12">
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Foreground="{StaticResource OverlayTextBrush}"/>
            <ProgressBar x:Name="DownloadProgress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" loc:Localize.TextKey="update.elevation.notice"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StartButton" Padding="16,8" Margin="0,0,8,0" loc:Localize.ContentKey="update.start" Click="Start_Click"/>
            <Button x:Name="CancelButton" Padding="16,8" loc:Localize.ContentKey="update.cancel" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
