<Window x:Class="TestOverlay.App.ProfileSlotValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        xmlns:controls="clr-namespace:TestOverlay.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Validate saved slots"
        loc:Localize.TitleKey="profile.validation.window.title"
        Icon="/Image/AppIcon.ico"
        Width="620"
        Height="480"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource OverlayBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="8,4,8,8" Style="{StaticResource AppWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:AppTitleBar Grid.Row="0"/>

        <Border Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource GlassCardStyle}">
            <StackPanel Margin="14,12">
                <TextBlock Text="Saved slot validation"
                           loc:Localize.TextKey="profile.validation.heading"
                           Style="{StaticResource SectionTitleStyle}"
                           Foreground="{StaticResource OverlayAccentBrush}"/>
                <TextBlock Margin="0,6,0,0"
                           Text="Checks saved quickslot and monitor positions against the current capture."
                           loc:Localize.TextKey="profile.validation.description"
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,9,0,0"
                           Text="{Binding Summary}"
                           FontWeight="SemiBold"
                           Foreground="{Binding SummaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,10" Style="{StaticResource InsetPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           Foreground="{Binding Brush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{StaticResource OverlayTextBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding Detail}"
                                               Foreground="{StaticResource OverlayMutedBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3"
                MinWidth="92"
                Height="34"
                Padding="14,0"
                Margin="0,6,0,0"
                HorizontalAlignment="Right"
                Content="Close"
                loc:Localize.ContentKey="Close"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
