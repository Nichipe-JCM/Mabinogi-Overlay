<Window x:Class="TestOverlay.App.CompactControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mabinogi Overlay"
        loc:Localize.TitleKey="Mabinogi Overlay"
        Icon="/Image/AppIcon.ico"
        Width="480"
        Height="560"
        MinWidth="420"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource OverlayBgBrush}"
        ResizeMode="CanResizeWithGrip">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="8" GlassFrameThickness="0"
                                  ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="8,4,8,8" Style="{StaticResource AppWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource GlassCardStyle}"
                PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
            <Grid Height="42" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Width="24" Height="24" Source="/Image/Logo.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" Text="Mabinogi Overlay" loc:Localize.TextKey="Mabinogi Overlay"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource OverlayAccentBrush}"/>
                    <TextBlock HorizontalAlignment="Center" Text="Compact mode" loc:Localize.TextKey="compact.mode"
                               FontSize="10" Foreground="{DynamicResource OverlayMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="34" Height="28" Padding="0" Click="MinimizeButton_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OverlayAccentBrush}"/>
                    </Button>
                    <Button Width="34" Height="28" Padding="0" Margin="4,0,0,0" Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OverlayAccentBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource GlassCardStyle}">
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ProfileText" FontWeight="SemiBold" Foreground="{DynamicResource OverlayTextBrush}"/>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Ellipse x:Name="OverlayStateDot" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverlayStateText" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" MinWidth="124" Height="36" Padding="14,0"
                        Content="Exit compact mode" loc:Localize.ContentKey="compact.full.mode"
                        Click="FullModeButton_Click"/>
                <Button x:Name="OverlayToggleButton" Grid.Column="2" MinWidth="112" Height="36" Padding="14,0" Margin="8,0,0,0"
                        Click="OverlayToggleButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}">
            <TabControl Margin="12" Style="{StaticResource RightPanelTabControlStyle}">
                <TabItem Header="Overlay" loc:Localize.HeaderKey="Overlay" Style="{StaticResource MonitorTabItemStyle}">
                    <StackPanel Margin="4,10,4,4">
                        <Border Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Overlay controls" loc:Localize.TextKey="overlay.controls" Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock Margin="0,6,0,12" Text="Open the layout manager to adjust placement and size."
                                           loc:Localize.TextKey="compact.layout.description" Style="{StaticResource MutedTextStyle}"/>
                                <Button Height="38" Content="Manage Layout" loc:Localize.ContentKey="Manage Layout"
                                        Click="ManageLayoutButton_Click"/>
                                <Separator Margin="0,12,0,10"/>
                                <CheckBox x:Name="BuffAlertsEnabledCheckBox" Margin="0,3"
                                          Content="Buff alerts" loc:Localize.ContentKey="compact.buff.alerts"
                                          Click="AlertEnabledCheckBox_Click"/>
                                <CheckBox x:Name="TuairimAlertsEnabledCheckBox" Margin="0,6,0,3"
                                          Content="Tuairim alerts" loc:Localize.ContentKey="compact.tuairim.alerts"
                                          Click="AlertEnabledCheckBox_Click"/>
                                <TextBlock Margin="0,8,0,0" Text="Monitoring continues while alerts are off."
                                           loc:Localize.TextKey="compact.alerts.description" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Buffs" loc:Localize.HeaderKey="compact.buff.tab" Style="{StaticResource MonitorTabItemStyle}">
                    <StackPanel Margin="4,10,4,4">
                        <TextBlock Text="Choose which configured buffs appear in the status overlay."
                                   loc:Localize.TextKey="compact.buff.description" Style="{StaticResource MutedTextStyle}"/>
                        <Border Margin="0,10,0,0" Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                                <CheckBox x:Name="BattleBuffCheckBox" Tag="monitor.buff.battle.overture" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/BattlefieldOn.png"/><TextBlock Text="Overture of the Battlefield" loc:Localize.TextKey="monitor.buff.battle.overture"/><TextBlock x:Name="BattleDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="MarchBuffCheckBox" Tag="monitor.buff.march.song" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/MarchOn.png"/><TextBlock Text="March" loc:Localize.TextKey="monitor.buff.march.song"/><TextBlock x:Name="MarchDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="VivaceBuffCheckBox" Tag="monitor.buff.vivace" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/VivaceOn.png"/><TextBlock Text="Vivace" loc:Localize.TextKey="monitor.buff.vivace"/><TextBlock x:Name="VivaceDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="HarvestBuffCheckBox" Tag="monitor.buff.harvest.song" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/RichyearOn.png"/><TextBlock Text="Song of rich year" loc:Localize.TextKey="monitor.buff.harvest.song"/><TextBlock x:Name="HarvestDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="DivineLinkBuffCheckBox" Tag="monitor.buff.divine.link" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/DivineLinkOn.png"/><TextBlock Text="Divine Link" loc:Localize.TextKey="monitor.buff.divine.link"/><TextBlock x:Name="DivineLinkDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ConditionSupportBuffCheckBox" Tag="monitor.buff.condition.support" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/ConditionSupportOn.png"/><TextBlock Text="Condition Support" loc:Localize.TextKey="monitor.buff.condition.support"/><TextBlock x:Name="ConditionSupportDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="PurificationWaveBuffCheckBox" Tag="monitor.buff.purification.wave" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/PurificationWaveOn.png"/><TextBlock Text="Purification Wave" loc:Localize.TextKey="monitor.buff.purification.wave"/><TextBlock x:Name="PurificationWaveDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="HamjjiBuffCheckBox" Tag="monitor.buff.hamjji" Margin="0,3"
                                          Style="{StaticResource CandidateCheckBoxStyle}" Click="BuffCheckBox_Click">
                                    <StackPanel Orientation="Horizontal"><Image Width="18" Height="18" Margin="0,0,7,0" Source="/Image/HamjjiOn.png"/><TextBlock Text="Hamjji" loc:Localize.TextKey="monitor.buff.hamjji"/><TextBlock x:Name="HamjjiDetectionStatusText" Margin="6,0,0,0" FontWeight="Bold"/></StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="BuffConfigurationText" Margin="2,9,2,0" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="TuairimConfigurationText" Margin="2,5,2,0" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Hotkey Timers" loc:Localize.HeaderKey="custom.timer.tab" Style="{StaticResource MonitorTabItemStyle}">
                    <ScrollViewer Margin="4,10,4,4" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configured hotkey timers and their current remaining time."
                                       loc:Localize.TextKey="compact.custom.timer.description"
                                       Style="{StaticResource MutedTextStyle}"/>
                            <Border Margin="0,10,0,0" Style="{StaticResource InsetPanelStyle}">
                                <StackPanel x:Name="CustomTimerList"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Erin Timer" loc:Localize.HeaderKey="erin.timer" Style="{StaticResource MonitorTabItemStyle}">
                    <ScrollViewer Margin="4,10,4,4" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Current Erin time" loc:Localize.TextKey="erin.current.time" Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock x:Name="ErinGameTimeText" Margin="0,6,0,0" FontSize="42"
                                           FontFamily="Bahnschrift Light, Segoe UI Variable" Foreground="{DynamicResource OverlayTextBrush}"/>
                                <TextBlock x:Name="ErinRealTimeText" Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="ErinNextAlarmText" Margin="0,7,0,0" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{DynamicResource OverlayAccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Alarms" loc:Localize.TextKey="erin.alarms" Style="{StaticResource PanelTitleStyle}"/>
                                <StackPanel x:Name="ErinAlarmList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeText" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource OverlayMutedBrush}"/>
            <Button Grid.Column="1" MinWidth="72" Height="32" Padding="12,0"
                    Content="Guide" loc:Localize.ContentKey="guide.button"
                    Click="GuideButton_Click"/>
        </Grid>
    </Grid>
</Window>
