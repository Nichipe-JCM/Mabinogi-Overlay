<Window x:Class="TestOverlay.App.LayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestOverlay.App.Services"
        xmlns:controls="clr-namespace:TestOverlay.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Overlay Layout Editor"
        loc:Localize.TitleKey="Overlay Layout Editor"
        Icon="/Image/AppIcon.ico"
        Width="1360"
        Height="920"
        MinWidth="1120"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource OverlayBgBrush}"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="8,4,8,8" Style="{StaticResource AppWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:AppTitleBar Grid.Row="0"/>


        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <TextBlock Text="Canvas and Screen" loc:Localize.TextKey="Canvas and Screen" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource OverlayAccentBrush}"/>
                    </Border>
                    <Grid Grid.Row="1" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Width" loc:Localize.TextKey="Width" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="CanvasWidthBox" Height="38"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Height" loc:Localize.TextKey="Height" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="CanvasHeightBox" Height="38"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Screen X" loc:Localize.TextKey="Screen X" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="ScreenLeftBox" Height="38"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="6">
                            <TextBlock Text="Screen Y" loc:Localize.TextKey="Screen Y" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="ScreenTopBox" Height="38"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7">
                            <TextBlock x:Name="GridSizeText" Style="{StaticResource MutedTextStyle}"/>
                            <Slider x:Name="GridSizeSlider" Minimum="1" Maximum="64" Value="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <TextBlock Text="Appearance" loc:Localize.TextKey="layout.appearance" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource OverlayAccentBrush}"/>
                    </Border>
                    <Grid Grid.Row="1" Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="All elements" loc:Localize.TextKey="layout.appearance.all"
                                           Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Margin="6,0,0,0" CornerRadius="9"
                                        Background="{StaticResource OverlayPanelElevatedBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1"
                                        ToolTipService.InitialShowDelay="120"
                                        ToolTipService.BetweenShowDelay="0"
                                        ToolTipService.ShowDuration="30000">
                                    <Border.ToolTip>
                                        <ToolTip Placement="Mouse" MaxWidth="380" Padding="12,10">
                                            <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                       Text="Adjusts the base opacity and size of every overlay element."
                                                       loc:Localize.TextKey="layout.appearance.all.help"/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource OverlayAccentBrush}" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="OpacityText" Text="Opacity" loc:Localize.TextKey="Opacity" Style="{StaticResource MutedTextStyle}"/>
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                            <TextBlock Margin="0,7,0,0" Text="Slot scale" loc:Localize.TextKey="Slot scale" Style="{StaticResource MutedTextStyle}"/>
                            <Slider x:Name="SlotScaleSlider" Minimum="0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="SlotScaleText" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Selected elements" loc:Localize.TextKey="layout.appearance.selected"
                                           Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Margin="6,0,0,0" CornerRadius="9"
                                        Background="{StaticResource OverlayPanelElevatedBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1"
                                        ToolTipService.InitialShowDelay="120"
                                        ToolTipService.BetweenShowDelay="0"
                                        ToolTipService.ShowDuration="30000">
                                    <Border.ToolTip>
                                        <ToolTip Placement="Mouse" MaxWidth="420" Padding="12,10">
                                            <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                                       Text="Hold Shift or Ctrl while clicking to select multiple elements, then adjust them together."
                                                       loc:Localize.TextKey="layout.appearance.selected.help"/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource OverlayAccentBrush}" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SelectedOpacityText" Text="Selected opacity" loc:Localize.TextKey="Selected opacity" Style="{StaticResource MutedTextStyle}"/>
                            <Slider x:Name="SelectedOpacitySlider" Minimum="0.05" Maximum="1" Value="1" TickFrequency="0.05"/>
                            <TextBlock x:Name="SelectedSlotScaleText" Margin="0,7,0,0" Text="Selected slot scale" loc:Localize.TextKey="Selected slot scale" Style="{StaticResource MutedTextStyle}"/>
                            <Slider x:Name="SelectedSlotScaleSlider" Minimum="0.1" Maximum="10" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <TextBlock Text="Runtime" loc:Localize.TextKey="Runtime" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource OverlayAccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="14">
                        <TextBlock Text="Stop hotkey" loc:Localize.TextKey="Stop hotkey" Style="{StaticResource MutedTextStyle}"/>
                        <controls:HotkeyInputBox x:Name="HotkeyBox" Height="38"/>
                        <TextBlock Margin="0,8,0,0" Text="Max FPS" loc:Localize.TextKey="Max FPS" Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="RefreshFpsCombo" Height="38"/>
                        <TextBlock Margin="0,8,0,0" Text="Alert preview rows" loc:Localize.TextKey="layout.alert.preview.rows" Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="AlertPreviewRowsCombo" Height="38"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Layout Canvas" loc:Localize.TextKey="Layout Canvas" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource OverlayAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="Drag slots, use arrow keys for fine movement, resize the canvas with the corner handle."
                                   loc:Localize.TextKey="Drag slots, use arrow keys for fine movement, resize the canvas with the corner handle."
                                   Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource OverlayBgBrush}">
                    <Border BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1" Background="{StaticResource OverlayPanelSoftBrush}">
                        <Grid x:Name="EditorSurface" Background="{StaticResource OverlayPanelSoftBrush}">
                            <Canvas x:Name="EditorCanvas"
                                    Focusable="True"
                                    Background="{StaticResource OverlayPanelSoftBrush}"
                                    MouseLeftButtonDown="EditorCanvas_MouseLeftButtonDown"
                                    MouseMove="EditorCanvas_MouseMove"
                                    MouseLeftButtonUp="EditorCanvas_MouseLeftButtonUp"/>
                            <Rectangle x:Name="EditorResizeBorder"
                                       Stroke="{StaticResource OverlayAccentBrush}"
                                       StrokeThickness="1"
                                       Fill="Transparent"
                                       IsHitTestVisible="False"/>
                            <primitives:Thumb x:Name="EditorResizeThumb"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Cursor="SizeNWSE"
                                              DragStarted="EditorResizeThumb_DragStarted"
                                              DragDelta="EditorResizeThumb_DragDelta"
                                              DragCompleted="EditorResizeThumb_DragCompleted">
                                <primitives:Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                        <Border Background="{StaticResource OverlayAccentBrush}" BorderBrush="#DFFFFF" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Line X1="5" Y1="16" X2="16" Y2="5" Stroke="#0F172A" StrokeThickness="1"/>
                                                <Line X1="10" Y1="16" X2="16" Y2="10" Stroke="#0F172A" StrokeThickness="1"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </primitives:Thumb.Template>
                            </primitives:Thumb>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0">
            <CheckBox x:Name="AllowPreviewPositionEditingCheckBox"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      Content="Allow position editing in preview"
                      loc:Localize.ContentKey="layout.preview.position.editing"/>
            <Button MinWidth="104" Height="34" Padding="14,0" Content="Default Pos" loc:Localize.ContentKey="Default Pos" Click="DefaultPositionButton_Click"/>
            <Button MinWidth="132" Height="34" Padding="14,0" Margin="8,0,0,0" Content="Screen Preview" loc:Localize.ContentKey="Screen Preview" Click="ScreenPreviewButton_Click"/>
            <Button MinWidth="122" Height="34" Padding="14,0" Margin="8,0,0,0" Content="Delete Selected" loc:Localize.ContentKey="Delete Selected" Click="DeleteSelectedButton_Click"/>
            <Button MinWidth="116" Height="34" Padding="14,0" Margin="8,0,0,0" Content="Save &amp; Close" loc:Localize.ContentKey="layout.save.and.close" Click="ApplyButton_Click"/>
            <Button MinWidth="96" Height="34" Padding="14,0" Margin="8,0,0,0" Content="Cancel" loc:Localize.ContentKey="Cancel" Click="CloseButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
