                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="TuairimSoundAlertsEnabledCheckBox" Grid.Column="0" Margin="0,0,18,0"
                                                          VerticalAlignment="Center" Content="Sound alert" loc:Localize.ContentKey="monitor.alert.sound.enabled"
                                                          Click="TuairimSoundAlertsEnabledCheckBox_Click"/>
                                                <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                           Text="Alert at" loc:Localize.TextKey="monitor.tuairim.alert.percent"/>
                                                <TextBox x:Name="TuairimAlertPercentBox" Grid.Column="2" Height="32" Padding="8,4"
                                                         Text="95" MaxLength="3" PreviewTextInput="AlertNumberTextBox_PreviewTextInput"
                                                         LostKeyboardFocus="TuairimAlertPercentBox_LostKeyboardFocus"/>
                                                <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Text="percent (90 ~ 100)" loc:Localize.TextKey="monitor.tuairim.alert.percent.range"
                                                           Style="{StaticResource MutedTextStyle}"/>
                                                <TextBlock Grid.Column="4" Margin="16,0,10,0" VerticalAlignment="Center"
                                                           Text="Alert frequency" loc:Localize.TextKey="monitor.tuairim.alert.frequency"/>
                                                <ComboBox x:Name="TuairimAlertFrequencyCombo" Grid.Column="5" Height="36"
                                                          VerticalContentAlignment="Center"
                                                          SelectionChanged="TuairimAlertFrequencyCombo_SelectionChanged">
                                                    <ComboBoxItem Tag="once" Content="Once" loc:Localize.ContentKey="monitor.tuairim.alert.frequency.once"/>
                                                    <ComboBoxItem Tag="every-percent" Content="Every 1%" loc:Localize.ContentKey="monitor.tuairim.alert.frequency.every.percent"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                                           Text="Alert sound" loc:Localize.TextKey="monitor.alert.sound"/>
                                                <TextBox x:Name="TuairimAlertSoundPathBox" Grid.Column="1"
                                                         Margin="0,0,8,0" Height="32" Padding="8,4" IsReadOnly="True"
                                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                <Button x:Name="BrowseTuairimAlertSoundButton" Grid.Column="2"
                                                        MinWidth="54" Height="32" Padding="9,0" Content="Open"
                                                        loc:Localize.ContentKey="monitor.alert.sound.open" Click="BrowseTuairimAlertSoundButton_Click"/>
                                                <Button x:Name="ClearTuairimAlertSoundButton" Grid.Column="3" Margin="6,0,0,0"
                                                        Width="34" Height="32" Content="X" FontWeight="Bold"
                                                        Click="ClearTuairimAlertSoundButton_Click"/>
                                                <Button x:Name="TestTuairimAlertSoundButton" Grid.Column="4" Margin="6,0,0,0"
                                                        MinWidth="58" Height="32" Padding="9,0" Content="Test"
                                                        loc:Localize.ContentKey="monitor.alert.sound.test" Click="TestTuairimAlertSoundButton_Click"/>
                                                <TextBlock Grid.Column="5" Margin="8,0,6,0" VerticalAlignment="Center"
                                                           Text="Volume" loc:Localize.TextKey="monitor.alert.sound.volume"/>
                                                <TextBox x:Name="TuairimAlertVolumeBox" Grid.Column="6" Height="32" Padding="7,4" MaxLength="3"
                                                         PreviewTextInput="AlertNumberTextBox_PreviewTextInput"
                                                         LostKeyboardFocus="TuairimAlertVolumeBox_LostKeyboardFocus"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}">
                            <Grid Margin="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="Overlay display"
                                           loc:Localize.TextKey="monitor.display.title"
                                           Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center"
                                           Text="Choose which detected information appears on the overlay."
                                           loc:Localize.TextKey="monitor.display.description"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource MutedTextStyle}"/>
                                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                    <CheckBox x:Name="ShowBuffTimerCheckBox" Margin="0,0,18,0"
                                              Content="Buff timer" loc:Localize.ContentKey="monitor.display.buff.timer"
                                              Click="MonitorDisplayCheckBox_Click"/>
                                    <CheckBox x:Name="ShowTuairimGaugeCheckBox" Margin="0,0,18,0"
                                              Content="Tuairim gauge" loc:Localize.ContentKey="monitor.display.tuairim"
                                              Click="MonitorDisplayCheckBox_Click"/>
                                    <CheckBox x:Name="ShowVisualAlertCheckBox"
                                              Content="Visual alert" loc:Localize.ContentKey="monitor.display.visual.alert"
                                              Click="MonitorDisplayCheckBox_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CustomTimerTabItem" Header="Hotkey Timers" loc:Localize.HeaderKey="custom.timer.tab">
                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hotkey timers" loc:Localize.TextKey="custom.timer.title" Style="{StaticResource SectionTitleStyle}"/>
                                    <CheckBox x:Name="CustomTimerOverlayVisibleCheckBox" Margin="0,10,0,10" Click="CustomTimerOverlayVisibleCheckBox_Click">
                                        <TextBlock Text="Show active timers on overlay"
                                                   loc:Localize.TextKey="custom.timer.overlay.visible"
                                                   TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>
                                <ListBox x:Name="CustomTimerList" Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1" SelectionChanged="CustomTimerList_SelectionChanged"/>
                                <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button x:Name="AddCustomTimerButton" MinWidth="72" Height="32" Padding="12,0" Content="Add" loc:Localize.ContentKey="Add" Click="AddCustomTimerButton_Click"/>
                                    <Button x:Name="RemoveCustomTimerButton" MinWidth="72" Height="32" Padding="12,0" Margin="6,0,0,0" Content="Delete" loc:Localize.ContentKey="Delete" Click="RemoveCustomTimerButton_Click"/>
                                </WrapPanel>
                            </Grid>
                            <Border Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                                <Grid Margin="12">
                                    <TextBlock x:Name="CustomTimerEmptyText" Text="Add or select a timer." loc:Localize.TextKey="custom.timer.empty" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="CustomTimerEditorPanel">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="CustomTimerEnabledCheckBox" Grid.ColumnSpan="2" Margin="0,0,0,10" Content="Enable this timer" loc:Localize.ContentKey="custom.timer.enabled" Click="CustomTimerOptionCheckBox_Click"/>
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Name" loc:Localize.TextKey="custom.timer.name"/>
                                            <TextBox x:Name="CustomTimerNameBox" Grid.Row="1" Grid.Column="1" Height="32" Padding="8,4" LostKeyboardFocus="CustomTimerEditor_LostKeyboardFocus"/>
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="Duration (seconds)" loc:Localize.TextKey="custom.timer.duration"/>
                                            <TextBox x:Name="CustomTimerDurationBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Height="32" Padding="8,4" LostKeyboardFocus="CustomTimerEditor_LostKeyboardFocus"/>
                                            <TextBlock Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center" Text="Alert before (seconds)" loc:Localize.TextKey="custom.timer.alert.before"/>
                                            <TextBox x:Name="CustomTimerAlertBeforeBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Height="32" Padding="8,4" LostKeyboardFocus="CustomTimerEditor_LostKeyboardFocus"/>
                                            <TextBlock Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Center" Text="Start / reload hotkey" loc:Localize.TextKey="custom.timer.start.hotkey"/>
                                            <controls:HotkeyInputBox x:Name="CustomTimerStartHotkeyBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Height="32" Padding="8,4" LostKeyboardFocus="CustomTimerEditor_LostKeyboardFocus"/>
                                            <TextBlock Grid.Row="5" Margin="0,8,0,0" VerticalAlignment="Center" Text="Cancel hotkey" loc:Localize.TextKey="custom.timer.cancel.hotkey"/>
                                            <controls:HotkeyInputBox x:Name="CustomTimerCancelHotkeyBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Height="32" Padding="8,4" LostKeyboardFocus="CustomTimerEditor_LostKeyboardFocus"/>
                                            <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                                <CheckBox x:Name="CustomTimerVisualAlertCheckBox" Margin="0,0,18,0" Content="Visual alert" loc:Localize.ContentKey="custom.timer.visual.enabled" Click="CustomTimerOptionCheckBox_Click"/>
                                                <CheckBox x:Name="CustomTimerSoundAlertCheckBox" Content="Sound alert" loc:Localize.ContentKey="custom.timer.sound.enabled" Click="CustomTimerOptionCheckBox_Click"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Row="7" Margin="0,8,0,0" VerticalAlignment="Center" Text="Alert sound" loc:Localize.TextKey="monitor.alert.sound"/>
                                            <Grid Grid.Row="7" Grid.Column="1" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="CustomTimerSoundPathBox" Height="32" Padding="8,4" IsReadOnly="True">
                                                    <TextBox.ToolTip>
                                                        <TextBlock Text="Default alert sound" loc:Localize.TextKey="monitor.alert.sound.default"/>
                                                    </TextBox.ToolTip>
                                                </TextBox>
                                                <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="54" Content="Open" loc:Localize.ContentKey="monitor.alert.sound.open" Click="BrowseCustomTimerSoundButton_Click"/>
                                                <Button Grid.Column="2" Margin="6,0,0,0" Width="34" Content="X" Click="ClearCustomTimerSoundButton_Click"/>
                                                <Button Grid.Column="3" Margin="6,0,0,0" MinWidth="58" Content="Test" loc:Localize.ContentKey="monitor.alert.sound.test" Click="TestCustomTimerSoundButton_Click"/>
                                            </Grid>
                                            <TextBlock Grid.Row="8" Margin="0,8,0,0" VerticalAlignment="Center" Text="Volume" loc:Localize.TextKey="monitor.alert.sound.volume"/>
                                            <TextBox x:Name="CustomTimerVolumeBox" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Height="32" Padding="8,4" LostKeyboardFocus="CustomTimerEditor_LostKeyboardFocus"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem x:Name="ErinTimerTabItem" Header="Erin Timer" loc:Localize.HeaderKey="erin.timer">
                    <local:ErinTimerWindow x:Name="ErinTimerPanel"/>
                </TabItem>

                <TabItem x:Name="DebugTabItem" Header="Debug" loc:Localize.HeaderKey="debug.tab"
                         Style="{StaticResource HiddenDebugTabItemStyle}">
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Margin="16">
                            <TextBlock Text="Debug" loc:Localize.TextKey="debug.tab" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="DebugDetectButton" MinWidth="116" Height="36" Padding="14,0"
                                        Content="Debug detect" loc:Localize.ContentKey="Debug detect" Click="DebugDetectButton_Click"/>
                                <Button x:Name="MonitorTestModeButton" MinWidth="120" Height="36" Padding="14,0" Margin="6,0,0,0"
                                        Content="Test mode" Click="MonitorTestModeButton_Click"/>
                                <Button x:Name="MonitorTestMode2Button" MinWidth="120" Height="36" Padding="14,0" Margin="6,0,0,0"
                                        Content="Test mode 2" Click="MonitorTestMode2Button_Click"/>
                            </WrapPanel>
                            <Border Margin="0,16,0,0" Style="{StaticResource InsetPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Benchmark" loc:Localize.TextKey="Benchmark" Style="{StaticResource PanelTitleStyle}"/>
                                    <TextBlock Margin="0,6,0,10"
                                               Text="Open a controlled stress test window to compare renderer cost."
                                               loc:Localize.TextKey="Open a controlled stress test window to compare renderer cost."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Button MinWidth="120" Height="34" Padding="12,0" HorizontalAlignment="Left"
                                            Content="Open benchmark" loc:Localize.ContentKey="Open benchmark"
                                            Click="BenchmarkButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
                <ToggleButton Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"
                              MinHeight="36" Padding="12,7" Content="Debug" loc:Localize.ContentKey="debug.tab"
                              IsChecked="{Binding IsSelected, ElementName=DebugTabItem, Mode=OneWay}"
                              Style="{StaticResource DebugTabToggleStyle}" Click="DebugTabToggle_Click"/>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Padding="12,8" Style="{StaticResource GlassCardStyle}">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       MaxHeight="72"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Text="The base UI is not topmost. The overlay is click-through. Configure the stop hotkey before Start."
                       loc:Localize.TextKey="The base UI is not topmost. The overlay is click-through. Configure the stop hotkey before Start."/>
        </Border>

        <Border x:Name="LayoutResetConfirmationOverlay" Grid.RowSpan="5" Panel.ZIndex="300"
                Background="#B0000000" Visibility="Collapsed">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource GlassCardStyle}">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Reset overlay layout" loc:Localize.TextKey="layout.reset.confirm.title"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Grid.Row="1" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="Remove every slot from the current overlay layout?"
                               loc:Localize.TextKey="layout.reset.confirm.message" Style="{StaticResource MutedTextStyle}"/>
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="5"
                            Background="#33FF5F57" BorderBrush="#99FF6B63" BorderThickness="1">
                        <TextBlock Text="This action cannot be undone." loc:Localize.TextKey="layout.reset.confirm.warning"
                                   Foreground="#FFFFB4AB" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button MinWidth="88" Height="34" Padding="14,0" Content="Cancel" loc:Localize.ContentKey="Cancel"
                                Click="CancelLayoutResetButton_Click"/>
                        <Button x:Name="ConfirmLayoutResetButton" MinWidth="112" Height="34" Padding="14,0" Margin="8,0,0,0"
                                Content="Reset layout" loc:Localize.ContentKey="layout.reset" Click="ConfirmLayoutResetButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="SlotResetConfirmationOverlay" Grid.RowSpan="5" Panel.ZIndex="300"
                Background="#B0000000" Visibility="Collapsed">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource GlassCardStyle}">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Reset slots" loc:Localize.TextKey="slot.reset.confirm.title" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Grid.Row="1" Margin="0,14,0,0" TextWrapping="Wrap" Text="Reset all slot candidates, sections, and overlay placements?" loc:Localize.TextKey="slot.reset.confirm.message" Style="{StaticResource MutedTextStyle}"/>
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="5" Background="#33FF5F57" BorderBrush="#99FF6B63" BorderThickness="1">
                        <TextBlock Text="This action cannot be undone." loc:Localize.TextKey="layout.reset.confirm.warning" Foreground="#FFFFB4AB" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button MinWidth="88" Height="34" Padding="14,0" Content="Cancel" loc:Localize.ContentKey="Cancel" Click="CancelSlotResetButton_Click"/>
                        <Button x:Name="ConfirmSlotResetButton" MinWidth="112" Height="34" Padding="14,0" Margin="8,0,0,0" Content="Reset slots" loc:Localize.ContentKey="slot.reset" Click="ConfirmSlotResetButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="InAppNoticeBorder" Grid.RowSpan="5" Panel.ZIndex="200"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,18,0"
                Padding="14,10" MaxWidth="520" Visibility="Collapsed"
                Background="#F22A2D30" BorderBrush="{StaticResource OverlayAccentBrush}"
                BorderThickness="1" CornerRadius="6" IsHitTestVisible="False">
            <TextBlock x:Name="InAppNoticeText" Foreground="{StaticResource OverlayTextBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
