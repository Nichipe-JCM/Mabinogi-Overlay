<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MabinogiOverlay.Updater</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TestOverlay.Update/TestOverlay.Update.csproj" />
    <EmbeddedResource Include="../TestOverlay.App/Localization/*.lang" Link="Localization/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
